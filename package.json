{
  "name": "kuna-mcp",
  "version": "1.0.0",
  "description": "MCP bridge that exposes the Kuna decompiler CLI as native MCP tools for any MCP host (Zeron, OpenCode, Claude Code, Codex, and others).",
  "type": "module",
  "bin": {
    "kuna-mcp": "src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "kuna",
    "decompiler",
    "reverse-engineering",
    "zeron"
  ]
}
